# Copy to .env, edit locally, then review .envrc and run direnv allow.
# .env is ignored. Never commit it or paste credentials into chat.
E2B_API_KEY=
GHAI_API_KEY=
GHAI_BASE_URL=
GHAI_PI_PRIMARY_MODEL=
# Optional decision model; reuses GHAI_BASE_URL (ending /v1) and GHAI_API_KEY.
GHAI_DECISION_MODEL=jev-latest
CONTEXT7_API_KEY=
# Required only for the separately approved GitHub publication step.
GH_TOKEN=
# Optional: set only if your existing Pi models.json is not in its usual agent dir.
# PI_MODELS_FILE=/absolute/path/to/models.json
